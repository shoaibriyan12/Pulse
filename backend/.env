# Copy this file to .env for local dev, or set these as environment
# variables / Docker secrets in production.

PORT=4000

# Postgres running on your VM. Replace VM_IP, credentials, and db name.
DATABASE_URL=postgres://pulse_user:shoaibriyankhanisabadboy@172.17.0.1:5432/pulse_fitness

# Set to "true" if your VM's Postgres requires SSL.
DATABASE_SSL=false

# Restrict which origins can call the API. Use your frontend's URL in production,
# e.g. https://pulse.yourdomain.com. "*" allows any origin (fine for local dev only).
CORS_ORIGIN=*

# Optional shared-secret auth. If set, all /api/* requests must send this
# value in the "x-api-key" header. Strongly recommended once this is exposed
# to the internet. Leave unset for local development.
API_KEY=
