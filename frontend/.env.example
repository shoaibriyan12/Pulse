# Base URL the frontend uses to reach the backend API.
# Local dev (backend running on your machine):
VITE_API_URL=http://localhost:4000

# Production (built into the Docker image at build time — see docker-compose.yml):
# VITE_API_URL=https://api.yourdomain.com
# or, if reverse-proxied under the same domain:
# VITE_API_URL=/api  (then also update src/lib/api.ts calls accordingly)

# Optional, must match the backend's API_KEY if you set one.
VITE_API_KEY=
